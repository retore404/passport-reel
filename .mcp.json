{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "pnpm",
      "args": [
        "dlx",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--isolated",
        "--executablePath=/home/vscode/.local/bin/chrome-headless-shell",
        "--chromeArg=--no-sandbox"
      ]
    }
  }
}
